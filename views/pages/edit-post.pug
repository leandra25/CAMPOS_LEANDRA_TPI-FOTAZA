extends ../layout

block content
  .container.mt-4
    .row.justify-content-center
      .col-md-6

        .card
          .card-body

            h3 Editar publicación

            form(action=`/publicaciones/editar/${publicacion.id_publicacion}` method="POST")

              input.form-control.mb-2(
                type="text"
                name="titulo"
                value=publicacion.titulo
              )

              textarea.form-control.mb-2(
                name="descripcion"
                rows="4"
              )= publicacion.descripcion

              button.btn.btn-primary(type="submit")
                | Guardar cambios