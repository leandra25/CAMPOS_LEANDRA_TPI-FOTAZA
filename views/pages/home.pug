extends ../layout

block content
  .container.mt-4
    .row

      // =========================
      // FEED PRINCIPAL
      // =========================
      .col-lg-8.col-md-7.mb-4

        if publicaciones.length === 0
          .alert.alert-info
            | No hay publicaciones

        each publicacion in publicaciones

          .card.mb-4.shadow-sm.border-0
            .card-body

              h3.fw-bold= publicacion.autor.username
              h4= publicacion.titulo

              // =========================
              // CARRUSEL
              // =========================
              if publicacion.imagenes && publicacion.imagenes.length > 0

                div(
                  id=`carousel-${publicacion.id_publicacion}`
                  class="carousel slide mb-3"
                )

                  .carousel-inner

                    each imagen, index in publicacion.imagenes

                      .carousel-item(class=index === 0 ? "active" : "")

                        img.w-100.rounded(
                          src=`/publicaciones/imagen/${imagen.id_imagen}`
                          style="height:250px; object-fit:cover;"
                        )

                        // =========================
                        // PROMEDIO
                        // =========================
                        if imagen.valoraciones

                          - const total = imagen.valoraciones.reduce((s, v) => s + v.puntaje, 0)
                          - const cantidad = imagen.valoraciones.length
                          - const promedio = cantidad ? (total / cantidad).toFixed(1) : 0

                          p.text-warning.fw-bold.mt-2
                            | #{promedio}/5 (#{cantidad} valoraciones)

                        else

                          p.text-warning.fw-bold.mt-2
                            | 0/5 (0 valoraciones)

                        // =========================
                        // RATING
                        // =========================

                        if publicacion.autor && usuario && publicacion.autor.id_usuario !== usuario.id_usuario

                          .d-flex.gap-1.mt-2.rating(
                            data-id=imagen.id_imagen
                            data-current=imagen.valoracionUsuario || 0
                          )

                            each estrella in [1,2,3,4,5]

                              i.bi.fs-5.star(
                                data-id=imagen.id_imagen
                                data-value=estrella
                                class=estrella <= (imagen.valoracionUsuario || 0)
                                  ? "bi-star-fill text-warning"
                                  : "bi-star"
                              )

                        else

                          p.text-muted.mt-2 

                  // =========================
                  // CONTROLES CARRUSEL
                  // =========================
                  if publicacion.imagenes.length > 1

                    button.carousel-control-prev(
                      type="button"
                      data-bs-target=`#carousel-${publicacion.id_publicacion}`
                      data-bs-slide="prev"
                    )
                      span.carousel-control-prev-icon

                    button.carousel-control-next(
                      type="button"
                      data-bs-target=`#carousel-${publicacion.id_publicacion}`
                      data-bs-slide="next"
                    )
                      span.carousel-control-next-icon

              // =========================
              // COMENTARIOS
              // =========================
              if publicacion.imagenes && publicacion.imagenes.length > 0

                form(
                  action="/comentarios/crear"
                  method="POST"
                  class="mt-3"
                )

                  input(
                    type="hidden"
                    name="id_imagen"
                    value=publicacion.imagenes[0].id_imagen
                  )

                  input(
                    type="hidden"
                    name="id_publicacion"
                    value=publicacion.id_publicacion
                  )

                  textarea.form-control.mb-2(
                    name="contenido"
                    rows="2"
                    placeholder="Escribe un comentario..."
                    required
                  )

                  button.btn.btn-primary.btn-sm(type="submit")
                    | Comentar

              // =========================
              // LISTA DE COMENTARIOS
              // =========================
              if publicacion.imagenes && publicacion.imagenes.length > 0

                each imagen, index in publicacion.imagenes

                  .comentarios(
                    data-imagen-id=imagen.id_imagen
                    class=index === 0 ? "" : "d-none"
                  )

                    if imagen.comentarios && imagen.comentarios.length > 0

                      each comentario in imagen.comentarios

                        .border.rounded.p-2.mb-2

                          strong= comentario.usuario ? comentario.usuario.username : "Usuario"

                          p.mb-0= comentario.contenido

                    else

                      p.text-muted Sin comentarios aún

      // =========================
      // SIDEBAR
      // =========================
      .col-lg-4.col-md-5

        .card.shadow-sm.border-0.position-sticky(style="top: 20px;")

          .card-header.bg-light.py-3
            h5.mb-0.fw-bold Sugerencias

          .card-body.p-3

            if !usuarios || usuarios.length === 0
              p.text-muted.small.mb-0 No hay usuarios

            else

              each usuario in usuarios

                .d-flex.justify-content-between.align-items-center.mb-3.border-bottom.pb-2

                  div
                    p.mb-0.fw-semibold= usuario.username
                    small.text-muted= usuario.email

                  if usuario.yaLoSigo

                    button.btn.btn-sm.btn-outline-secondary.btn-seguir(
                      data-id=usuario.id_usuario
                    )
                      | Siguiendo

                  else

                    button.btn.btn-sm.btn-primary.btn-seguir(
                      data-id=usuario.id_usuario
                    )
                      | Seguir

    script(src="/js/follow.js")
    script(src="/js/imagenes.js")